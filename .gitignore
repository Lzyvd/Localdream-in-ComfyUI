# ── Python 生成物 ──
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.DS_Store

# ── 本机 / 真机隐私：请勿 push 到 GitHub ──
# 含手机局域网 IP、双端口、默认模型、超时等本机连接配置
settings.json
settings.json.tmp
settings.*.json
!settings.example.json
# 含设备模型清单与手机内部存储绝对路径（/storage/emulated/0/...）
models_cache.json
models_cache.*.json
# 运行日志会记录设备 URL、模型 id 与提示词
*.log
*.log.*
# 本地环境变量 / 私有覆盖
.env
.env.*
*_local.json

# ── 测试与运行产物 ──
# 测试目录按仓库约定不发布（含离线 harness 与验证截图）
tests/
tests/_harness/
tests/_out/
realdevice*/
output/
